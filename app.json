{
  "expo": {
    "name": "Bored Doom",
    "slug": "bored-doom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "boreddoom",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16302B",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-milo.png",
      "resizeMode": "contain",
      "backgroundColor": "#16302B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dwayne.boreddoom",
      "infoPlist": { "UIBackgroundModes": ["remote-notification"] }
    },
    "android": {
      "package": "com.dwayne.boreddoom",
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#16302B" },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "color": "#E88D4F" }],
      ["expo-splash-screen", { "backgroundColor": "#16302B", "image": "./assets/splash-milo.png", "imageWidth": 200 }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
